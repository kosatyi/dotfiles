custom-shader = shaders/cursor_smear.glsl
custom-shader = shaders/glitchy.glsl

font-family = "JetBrainsMono Nerd Font"
font-size = 12

keybind = ctrl+shift+[=goto_split:previous
keybind = ctrl+shift+]=goto_split:next
keybind = shift+home=unbind
keybind = shift+end=unbind

split-divider-color = #313244
window-padding-color = extend-always
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-step-resize = true
##window-decoration = false
maximize = true
theme = Catppuccin Mocha
gtk-titlebar = false
#Core Quick Terminal Settings
# keybind = global:ctrl+shift+enter=toggle_quick_terminal
# quick-terminal-position = top
# quick-terminal-size = 40%
# quick-terminal-animation-duration = 0.2

shell-integration = bash
shell-integration-features = true
